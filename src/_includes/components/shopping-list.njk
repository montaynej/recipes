<div data-shopping-list data-shopping-url="{{ '/data/shopping.json' | url }}">
  <p data-shopping-status role="status" aria-live="polite" aria-atomic="true"></p>
  <button class="selection-button" data-shopping-retry type="button" hidden>Try again</button>
  <div class="empty-state" data-shopping-empty hidden>
    <p class="status-label">A good meal starts with a plan</p>
    <p>Select some recipes to build your shopping list.</p>
    <a class="text-link" href="{{ '/' | url }}#recipes">Browse recipes <span aria-hidden="true">→</span></a>
  </div>
  <div class="shopping-groups" data-shopping-groups></div>
</div>
