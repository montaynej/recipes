<article class="recipe-card"{% if isMealPlan %} data-plan-recipe="{{ recipe.id }}" hidden{% endif %}>
  <img src="{{ recipe.image | url }}" alt="{{ recipe.imageAlt | escape }}" width="800" height="560" loading="lazy" decoding="async">
  <div class="recipe-card-body">
    <p class="eyebrow">{{ recipe.category | capitalize }}</p>
    <h3><a href="{{ ('/recipes/' ~ recipe.id ~ '/') | url }}">{{ recipe.title | escape }}</a></h3>
    <p>{{ recipe.description | escape }}</p>
    {% include "components/recipe-meta.njk" %}
    <a class="text-link" href="{{ ('/recipes/' ~ recipe.id ~ '/') | url }}">View recipe<span class="visually-hidden">: {{ recipe.title | escape }}</span> <span aria-hidden="true">→</span></a>
    {% include "components/selection-button.njk" %}
  </div>
</article>
