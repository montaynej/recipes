<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }} | {{ site.name }}</title>
    <meta name="description" content="{{ description or site.description }}">
    <link rel="stylesheet" href="{{ '/css/styles.css' | url }}">
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {% include "components/navigation.njk" %}
    <div class="container">
      <p data-storage-warning role="status" hidden></p>
      <p class="visually-hidden" data-plan-status role="status" aria-live="polite" aria-atomic="true"></p>
    </div>
    <main id="main" class="container" tabindex="-1">
      {{ content | safe }}
    </main>
    {% include "components/footer.njk" %}
    <script type="application/json" data-recipe-ids>{{ recipes | recipeIdsJson | safe }}</script>
    <script type="module" src="{{ '/js/recipes.js' | url }}"></script>
  </body>
</html>
